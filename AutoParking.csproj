<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AutoParking</AssemblyName>
    <RootNamespace>AutoParking</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Tools\ is the offline dev harness, a project of its own. Default globbing would compile
         its sources straight into this DLL. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Tools\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
